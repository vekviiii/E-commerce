{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Backend",
      "program": "${workspaceFolder}/api/server.js",
      "cwd": "${workspaceFolder}/api",
      "runtimeArgs": ["--inspect=9229"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Frontend",
      "program": "${workspaceFolder}/client/package.json",
      "cwd": "${workspaceFolder}/client",
      "runtimeArgs": ["--inspect=9230"]
    }
  ],
  "compounds": [
    {
      "name": "Debug Both (Frontend + Backend)",
      "configurations": ["Backend", "Frontend"]
    }
  ]
}
